APP_NAME="PolicyFlow AI"
APP_ENV=development
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=

LLM_PROVIDERS=groq,openai,anthropic,gemini
LLM_TIMEOUT_SECONDS=30
LLM_COOLDOWN_SECONDS=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_FAST_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-flash-lite-latest

TAVILY_API_KEY=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=policyflow-hr-kb
PINECONE_NAMESPACE=hr-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

TOP_K=4
MIN_RELEVANCE_SCORE=0.25
STRONG_RELEVANCE_SCORE=0.6
MAX_RETRIES=1
SEED_KNOWLEDGE_BASE=true

ADMIN_API_KEY=

